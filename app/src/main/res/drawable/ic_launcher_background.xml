<?xml version="1.0" encoding="utf-8"?>
<!-- A gradient rather than a flat fill, and a vector rather than a bitmap: the whole icon is
     four paths, so it costs nothing at any density and has no seam to match. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="@color/brand_teal_light" />
                <item android:offset="1" android:color="@color/ic_launcher_background" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
