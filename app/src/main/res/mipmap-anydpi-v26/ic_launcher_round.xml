<?xml version="1.0" encoding="utf-8"?>
<!--
  The artwork is full-bleed, but a launcher only guarantees the central 72 of the 108dp
  canvas survives its mask. Insetting the artwork and filling the remainder with its own
  background colour keeps the whole mark visible under a circle, a squircle or a rounded
  square, with no visible seam.

  The monochrome layer is the three-dot mark the renderer draws between vocal lines —
  a silhouette the photographic artwork cannot provide.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="10dp" />
    </foreground>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
