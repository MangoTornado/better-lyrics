<?xml version="1.0" encoding="utf-8"?>
<!--
  All three layers are vectors, so there is nothing to export per density and no bitmap to
  match a background colour against. The mark is drawn inside the central 66dp that survives
  every launcher mask, which is why no inset is needed here.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
