# Copy to keystore.properties and fill in. Never commit the real file, and keep the
# keystore itself outside the repository — losing it means you can never ship an update
# that upgrades an already-installed copy of the app.
# This project's own key predates the rename to Melisma, and keeps its name because the
# alias is stored inside the keystore file. A fresh one can be called anything.
storeFile=/absolute/path/to/better-lyrics-release.jks
storePassword=…
keyAlias=better-lyrics
keyPassword=…
